<mxfile host="app.diagrams.net"><diagram name="How Sheep is built" id="how-sheep-is-built"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Sheep desktop app (Electron): chat · Words · Sheets · Slides · Studio · Text · Work Canvas · Settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1300" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Local server (server.py)
localhost only, HTTP + live events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Agent: request → tool calls
(typo fix, routing, shepherd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="150" width="260" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Tools shared with the editors
files · Words · Sheets · Slides · Studio · web · media" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="150" width="300" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Workspace: every file Sheep makes,
with undo for every change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1050" y="150" width="290" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Orchestrator: plans the device, starts the engine, checks answers, engine tune, heat (pause at 99 °C), repair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="300" height="90" as="geometry"/></mxCell><mxCell id="c9" value="Checker: rules (and an optional small model) read every answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="280" width="260" height="90" as="geometry"/></mxCell><mxCell id="c10" value="Who answers each step:
the local model, or Nemotron on Nebius" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="280" width="300" height="90" as="geometry"/></mxCell><mxCell id="c11" value="Sheep engine (sml-server, C + OpenMP + CUDA)
.ssf model on CPU, GPU or both" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="300" height="80" as="geometry"/></mxCell><mxCell id="c12" value="Compatibility mode
(transformers on the original weights)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="430" width="260" height="80" as="geometry"/></mxCell><mxCell id="c13" value="AMD / Intel graphics (DirectML)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="300" height="80" as="geometry"/></mxCell><mxCell id="c14" value="Media workers: pictures + video (SD 1.5 + LCM, AnimateDiff), Whisper speech, Windows voices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1050" y="280" width="290" height="90" as="geometry"/></mxCell><mxCell id="c15" value="NVIDIA Nemotron on Nebius
plans big jobs, checks the local draft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1050" y="430" width="290" height="80" as="geometry"/></mxCell><mxCell id="c16" value="Web search (Tavily), one of the tools:
answers about now, with sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1050" y="570" width="290" height="80" as="geometry"/></mxCell><mxCell id="c17" value="requests" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="tool calls" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="files" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="drafts" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="starts, plans" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="unfamiliar models" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="pictures, video, speech" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="Sheep + Nebius mode" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="Everything runs on this computer except the two purple boxes, which the person can switch off (Settings › Basics). Every request that leaves the computer is listed in Settings › Advanced › Sent out." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="560" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="One request end to end" id="one-request-end-to-end"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="You type: 'powrpoint about the history of coffee'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="30" width="760" height="64" as="geometry"/></mxCell><mxCell id="c4" value="Typo fix: 'powrpoint' → 'powerpoint' (cues.fix)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="130" width="760" height="64" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="Routing: a deck request gets the Slides tools; a video request gets the video tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="230" width="760" height="64" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="Missing a model for it? The reply shows what is missing with a Download / Choose another button" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="330" width="760" height="64" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="Sheep mode: the local model writes, the shepherd turns it into tool calls.
Sheep + Nebius: Nemotron plans exact tool calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="430" width="760" height="64" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="Tools make the real file in the workspace (undo works)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="530" width="760" height="64" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="Checks: the file is opened and compared with what was asked; Nemotron reviews the draft when on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="630" width="760" height="64" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="Reply with the file card: Open · .pptx · Canvas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="730" width="760" height="64" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A model from a name to Ready" id="a-model-from-a-name-to-ready"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Any Hugging Face ID, a folder or a .gguf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Fit check before download: size, licence, will it run here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="60" width="300" height="90" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="Download the original weights (or convert GGUF / GPTQ / AWQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="300" height="90" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="Known family → build .ssf at the chosen level
Unknown family → auto-fit, else compatibility mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1030" y="60" width="300" height="90" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="Orchestrator plans the device (GPU, CPU or both) and starts the engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1030" y="240" width="300" height="90" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="Model ready → answers checked → apps checked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="240" width="300" height="90" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="Speed trial: the fastest device for this model here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="240" width="300" height="90" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="Engine tune: faster GPU settings, kept only if the answer is identical" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="300" height="90" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="Ready: the lamp turns green" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="300" height="70" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;html=1;rounded=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="Picture, video and speech models: one row per job in Settings › Models. Any SD 1.5 model or faster-whisper model is checked, downloaded and given a test run before use." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="600" height="90" as="geometry"/></mxCell><mxCell id="c21" value="Each step is shown to the person in Settings › Activity › What Sheep did for you. Checks pause only when the graphics card reaches 99 °C." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="980" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
