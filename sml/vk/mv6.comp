#version 450
#extension GL_GOOGLE_include_directive : enable
// y = W x (+ bias) for a flat 6-bit tensor: the nibble plane plus the 2-bit group-planar
// plane, code = lo4 + 16 * hi2, per 128-weight pack (sml_g_smv6). Four rows per
// workgroup, 16 threads per row, 16-byte vector reads (see mv4.comp).
#include "common.glsl"
layout(local_size_x = 64) in;
layout(push_constant) uniform P {
    uint y, c2, c4, sd, sq, md, mq, qw, qs, qm, bias, rows, n, have_min, has_bias;
} p;
shared float part[64];

void main() {
    const uint t = gl_LocalInvocationID.x, lane = t & 15u, sub = t >> 4u;
    const uint ng = p.n / GROUP, nscale = (ng + GPS - 1u) / GPS, npack = p.n / 128u;
    for (uint rb = gl_WorkGroupID.x; rb * 4u < p.rows; rb += gl_NumWorkGroups.x) {
        const uint r = rb * 4u + sub;
        float acc = 0.0;
        if (r < p.rows) {
            const uint r2 = (p.c2 + r * (p.n / 16u)) >> 2u, r4 = (p.c4 + r * (p.n / 8u)) >> 2u;
            const uint qa = p.qw >> 2u;
            for (uint pk = lane; pk < npack; pk += 16u) {
                const uint base = pk * 4u;
                int d0 = 0, d1 = 0, d2 = 0, d3 = 0, e0 = 0, e1 = 0, e2 = 0, e3 = 0;
                for (uint h = 0u; h < 2u; h++) {                         // words 0-3, then 4-7
                    const uvec4 w2 = wu4[r2 + pk * 2u + h];
                    const uvec4 wa = wu4[r4 + pk * 4u + h], wb = wu4[r4 + pk * 4u + 2u + h];
                    const uvec4 a0 = su4[qa + (base + 0u) * 2u + h], a1 = su4[qa + (base + 1u) * 2u + h];
                    const uvec4 a2 = su4[qa + (base + 2u) * 2u + h], a3 = su4[qa + (base + 3u) * 2u + h];
                    for (uint k = 0u; k < 4u; k++)
                        for (uint b = 0u; b < 4u; b++) {
                            const uint s8 = 8u * b;
                            const uint b2 = (w2[k] >> s8) & 0xFFu, ba = (wa[k] >> s8) & 0xFFu, bb = (wb[k] >> s8) & 0xFFu;
                            const int x0 = sb(a0[k], b), x1 = sb(a1[k], b), x2 = sb(a2[k], b), x3 = sb(a3[k], b);
                            d0 += int(b2 & 3u) * x0;          d1 += int((b2 >> 2u) & 3u) * x1;
                            d2 += int((b2 >> 4u) & 3u) * x2;  d3 += int((b2 >> 6u) & 3u) * x3;
                            e0 += int(ba & 0x0Fu) * x0;       e1 += int(ba >> 4u) * x1;
                            e2 += int(bb & 0x0Fu) * x2;       e3 += int(bb >> 4u) * x3;
                        }
                }
                const int ds[4] = int[4](e0 + 16 * d0, e1 + 16 * d1, e2 + 16 * d2, e3 + 16 * d3);
                for (uint g = 0u; g < 4u; g++) {
                    const uint gi = base + g;
                    const float xs = sf[p.qs + gi];
                    acc += whalf(p.sd, r * nscale + gi / GPS) * float(wbyte(p.sq, r * ng + gi)) * xs * float(ds[g]);
                    if (p.have_min != 0u)
                        acc += whalf(p.md, r * nscale + gi / GPS) * (float(wbyte(p.mq, r * ng + gi)) - 127.0) * xs
                               * float(int(su[p.qm + gi]));
                }
            }
        }
        part[t] = acc;
        barrier();
        for (uint s = 8u; s > 0u; s >>= 1) {
            if (lane < s) part[t] += part[t + s];
            barrier();
        }
        if (lane == 0u && r < p.rows) sf[p.y + r] = part[t] + (p.has_bias != 0u ? wf[p.bias + r] : 0.0);
        barrier();
    }
}
